		(property "MPN" "" (at 101.6 218.44 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Purpose" "Cảm biến nhiệt độ (I2C): sai số chip ±0.1 °C trong +30…+50 °C; nhiệt độ da còn phụ thuộc đường dẫn nhiệt cơ khí. Hàn reflow tối đa +220 °C. GPIO1 = 1, GPIO0 = 0 → địa chỉ 0x52 (tránh 0x51 của RTC); đọc theo chu kỳ, không dùng INT. Đặt sát tấm tiếp xúc da, cách xa LDO/LED (nguồn nhiệt)." (at 101.6 218.44 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Reference_doc" "M30 p.1, p.2 (reflow, sai số), p.6 (chân), p.7 (lắp đặt), Table 3 p.10 (địa chỉ)" (at 101.6 218.44 0) (effects (font (size 1.27 1.27)) (hide yes)))
