	(symbol (lib_id "Logic_LevelTranslator:TXS0108EPW") (at 254.0 142.24 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "ee6875e8-8b2d-5a23-944a-5a6cc6c639c8")
		(property "Reference" "U203" (at 265.16 125.46 0) (effects (font (size 1.27 1.27)) (justify left)))
		(property "Value" "TXS0108EPWR" (at 265.16 127.06 0) (effects (font (size 1.0 1.0)) (justify left)))
		(property "Footprint" "Package_SO:TSSOP-20_4.4x6.5mm_P0.65mm" (at 254.0 142.24 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Datasheet" "LCSC_C17206_TXS0108E.pdf" (at 254.0 142.24 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "LCSC" "C17206" (at 254.0 142.24 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "MPN" "" (at 254.0 142.24 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Purpose" "Chuyển mức 2 chiều tự động 1.8 V ↔ 3.3 V cho SPI + INT: logic MAX86141 chạy ở 1.8 V (VOH SDO không đủ), còn ESP32 cần VIH ≥ 0.75·3.3 V. OE nối thẳng VCCA vì FPC 16 chân không còn chân để đưa tín hiệu OE sang bo cảm biến (GPIO47/48 của ESP32 còn trống). VCCA = 1.8 V ≤ VCCB = 3.3 V luôn đúng vì 1V8 lấy từ 3V3. Kênh 6-8 để trống (có điện trở kéo lên nội)." (at 254.0 142.24 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Reference_doc" "TXS p.1, p.4 (chân), p.6 (OE: VIH, Δt/Δv ≤ 10 ns/V), §7.3.5 p.18 (pull-up 4k/40k nội), §8.3 p.20 (VCCA ≤ VCCB); MAX p.8 (mức logic), DS Table 5-4 p.65 (VIH = 0.75·VDD)" (at 254.0 142.24 0) (effects (font (size 1.27 1.27)) (hide yes)))
