		(property "Purpose" "AFE quang PPG: 3 bộ lái LED (tới 124 mA), 2 kênh ADC dòng 19-bit cho 2 photodiode chạy đồng thời, khử ánh sáng môi trường, FIFO 128 mẫu. SPI tối đa 4 MHz ở mức 1.8 V. LED1 = xanh lá (nhịp tim), LED2 = đỏ, LED3 = hồng ngoại (SpO2). GPIO1/2 không dùng (để trống được)." (at 187.96 139.7 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Reference_doc" "MAX p.1, p.6 (VLED, VDD), p.8 (SPI 4 MHz, VIH 1.4 V), p.11 (bump map), p.12 (chân)" (at 187.96 139.7 0) (effects (font (size 1.27 1.27)) (hide yes)))
